#version 450

// The volumetric clouds' noise (render/cloud_renderer.cpp), made once when the clouds are made: every texture tiles,
// so the cloud field repeats without seams. No noise file ships; this draws it.
//   mode 0, the shape (128^3): r Perlin-Worley (gradient noise whose low values Worley noise lifts into round,
//          billowing cells), g b a Worley noise at three rising frequencies.
//   mode 1, the detail (32^3): r g b Worley noise at three rising frequencies, to wear the shape's edges away.
//   mode 2, the weather map (512^2): r where cloud grows, g its type (flat .. towering).
// After Schneider's cloud system for Horizon Zero Dawn (SIGGRAPH 2015, "The Real-time Volumetric Cloudscapes of
// Horizon: Zero Dawn"); the noise functions are this file's own.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(binding = 0, rgba8) uniform writeonly image3D u_shape;
layout(binding = 1, rgba8) uniform writeonly image3D u_detail;
layout(binding = 2, rgba8) uniform writeonly image2D u_weather;

layout(push_constant) uniform Push {
    uint mode;
} pc;

// Jarzynski and Olano's pcg3d ("Hash Functions for GPU Rendering", JCGT 2020).
uvec3 pcg3d(uvec3 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    return v;
}

// A point in the unit cube for lattice cell `c` (already wrapped into the period).
vec3 cell_random(ivec3 c, uint seed) {
    return vec3(pcg3d(uvec3(c) + uvec3(seed * 0x9e37u, seed * 0x85ebu, seed * 0xc2b2u))) * (1.0 / 4294967295.0);
}

ivec3 wrap(ivec3 c, int period) {
    return ((c % period) + period) % period;
}

// Worley (cellular) noise over `p` in the unit cube, `period` cells a side, tiling: 1 at a feature point falling to 0
// a cell away.
float worley(vec3 p, int period, uint seed) {
    vec3 g = p * float(period);
    ivec3 c = ivec3(floor(g));
    vec3 f = g - vec3(c);
    float nearest = 1e9;
    for (int z = -1; z <= 1; ++z)
        for (int y = -1; y <= 1; ++y)
            for (int x = -1; x <= 1; ++x) {
                ivec3 o = ivec3(x, y, z);
                vec3 at = vec3(o) + cell_random(wrap(c + o, period), seed);
                vec3 d = f - at;
                nearest = min(nearest, dot(d, d));
            }
    return 1.0 - clamp(sqrt(nearest), 0.0, 1.0);
}

float worley_fbm(vec3 p, int period, uint seed) {
    return worley(p, period, seed) * 0.625 + worley(p, period * 2, seed + 1u) * 0.25 +
           worley(p, period * 4, seed + 2u) * 0.125;
}

// Gradient (Perlin-style) noise, tiling over `period` cells: about -1..1.
float gradient_noise(vec3 p, int period, uint seed) {
    vec3 g = p * float(period);
    ivec3 c = ivec3(floor(g));
    vec3 f = g - vec3(c);
    vec3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float v[8];
    for (int i = 0; i < 8; ++i) {
        ivec3 o = ivec3(i & 1, (i >> 1) & 1, (i >> 2) & 1);
        vec3 grad = normalize(cell_random(wrap(c + o, period), seed) * 2.0 - 1.0 + 1e-4);
        v[i] = dot(grad, f - vec3(o));
    }
    float x0 = mix(v[0], v[1], u.x), x1 = mix(v[2], v[3], u.x);
    float x2 = mix(v[4], v[5], u.x), x3 = mix(v[6], v[7], u.x);
    return mix(mix(x0, x1, u.y), mix(x2, x3, u.y), u.z) * 1.6;
}

// Octaves of gradient noise, each twice the last's frequency and half its weight: 0..1, about 0.5 on average.
float gradient_fbm(vec3 p, int period, int octaves, uint seed) {
    float sum = 0.0, weight = 0.5, total = 0.0;
    for (int i = 0; i < octaves; ++i) {
        sum += gradient_noise(p, period << i, seed + uint(i)) * weight;
        total += weight;
        weight *= 0.5;
    }
    return clamp(sum / total * 0.5 + 0.5, 0.0, 1.0);
}

float remap(float v, float lo, float hi, float new_lo, float new_hi) {
    return new_lo + (v - lo) / max(hi - lo, 1e-5) * (new_hi - new_lo);
}

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (pc.mode == 0u) {
        if (any(greaterThanEqual(id, ivec3(128)))) return;
        vec3 p = (vec3(id) + 0.5) / 128.0;
        float worley4 = worley_fbm(p, 4, 11u);
        float perlin = gradient_fbm(p, 4, 4, 3u);
        // Stretched about its middle: fbm piles up round 0.5, and the clouds need its whole range.
        perlin = clamp((perlin - 0.5) * 2.0 + 0.5, 0.0, 1.0);
        float perlin_worley = clamp(remap(perlin, 0.0, 1.0, worley4, 1.0), 0.0, 1.0);
        imageStore(u_shape, id, vec4(perlin_worley, worley4, worley_fbm(p, 8, 21u), worley_fbm(p, 16, 31u)));
    } else if (pc.mode == 1u) {
        if (any(greaterThanEqual(id, ivec3(32)))) return;
        vec3 p = (vec3(id) + 0.5) / 32.0;
        imageStore(u_detail, id, vec4(worley_fbm(p, 2, 41u), worley_fbm(p, 4, 51u), worley_fbm(p, 8, 61u), 1.0));
    } else {
        if (id.z != 0 || any(greaterThanEqual(id.xy, ivec2(512)))) return;
        vec3 p = vec3((vec2(id.xy) + 0.5) / 512.0, 0.37);
        // Where cloud grows: broad gradient noise, broken up by cells so the gaps between clouds are rounded.
        float broad = gradient_fbm(p, 4, 5, 71u);
        float cells = worley(p, 12, 81u);
        float cover = clamp((broad - 0.5) * 2.2 + 0.5, 0.0, 1.0) * mix(0.75, 1.0, cells);
        float type = clamp((gradient_fbm(p, 3, 3, 91u) - 0.5) * 2.0 + 0.5, 0.0, 1.0);
        imageStore(u_weather, id.xy, vec4(cover, type, 0.0, 1.0));
    }
}
