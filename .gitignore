build/
build-*/
.local/
.claude/worktrees/
build.log
build-*.log
# Client and headless run logs; they hold character names and server addresses.
/logs/
# Plugins kept in repositories of their own, cloned here so CMake builds them with the client (CMakeLists.txt): the
# NMS and Project Triune server plugins, and HSMono (the MQ2Mono port). Their changes are committed in their own
# repositories, never here.
/plugins/nms
/plugins/projecttriune
/plugins/hsmono
__pycache__/
# What a local release writes in the checkout (docs/updater.md "Making a release", docs/addons.md "For authors").
/dist/
/release/
# Container builds (compose.yaml, tools/docker/build.sh): ccache, MSVC, the Wine home
/.docker/
# luac -p writes this in the folder it runs in
luac.out
# Windows build outputs that must not be committed: binaries at the checkout root and the compiled shaders
# a build writes beside their sources (they belong in build/hailstone/shaders/).
/hailstone_headless.exe
/zlib1.dll
/shaders/*.spv
/docs/research/hailstorm-private-review.md
